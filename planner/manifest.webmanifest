  "icons": [
    { "src": "iconos/192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "iconos/512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "iconos/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
